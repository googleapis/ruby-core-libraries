.DS_STORE
.bundle/
/.yardoc
/_yardoc/
/doc/
/pkg/
/spec/reports/
/tmp/
*.bundle
*.so
*.o
*.a
mkmf.log
vendor
*~
.idea
*.iml

# Modified Gemfiles toys writes while running a step; bundler re-creates the lock
# just after toys deletes it, so a stray one is left behind by every `toys ci`.
.toys-tmp-gemfile-*
